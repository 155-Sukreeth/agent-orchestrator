# Bifrost — provider keys (read by Bifrost container via env.VAR_NAME in config.json)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
MISTRAL_API_KEY=...

# Backend -> Agents connection
AGENTS_API_URL=http://localhost:8001

# Agents -> Bifrost connection
AGENTS_BIFROST_URL=http://localhost:8080/v1
AGENTS_BIFROST_API_KEY=dummy
AGENTS_DEFAULT_PROVIDER=openai
AGENTS_DEFAULT_MODEL=gpt-4o

# Backend (legacy embedding settings, no longer heavily used due to Bifrost Semantic routing)
SEMANTIC_ROUTER_OPENAI_API_KEY=sk-...
SEMANTIC_SIMILARITY_THRESHOLD=0.72
EMBEDDING_MODEL=text-embedding-3-small

# App
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentplatform
REDIS_URL=redis://localhost:6379
PUBLIC_URL=https://your-ngrok-url.ngrok.io
TELEGRAM_BOT_TOKEN=...
TELEGRAM_WEBHOOK_SECRET=...
