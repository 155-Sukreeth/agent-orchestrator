PUBLIC_URL=https://your-public-domain.com

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/orchestrator
REDIS_URL=redis://localhost:6379

AGENTS_BIFROST_URL=https://gateway.maximai.io/v1
AGENTS_BIFROST_API_KEY=your_bifrost_api_key_here

AGENTS_DEFAULT_PROVIDER=openai
AGENTS_DEFAULT_MODEL=gpt-4o

OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_SIMILARITY_THRESHOLD=0.72

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here
